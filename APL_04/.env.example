# 이 파일을 복사해 .env로 만들고 값을 채운다:  copy .env.example .env
# .env는 APL_04/.env 또는 저장소 루트 .env 어디에 둬도 서버 시작 때 자동으로 읽힌다(APL_04가 우선).
# 터미널에서 먼저 지정한 환경변수($env:KEY=...)는 .env보다 우선한다. 값이 없는 항목은 주석 처리해 둔다.
# 아무것도 설정하지 않으면 전사·요약·결정 사항 추출은 가짜(고정) 응답으로 동작한다.

# ===== Django =====
# 1이면 개발 모드. 0(운영)이면 DJANGO_SECRET_KEY가 반드시 필요하다.
DJANGO_DEBUG=1
# 운영(DJANGO_DEBUG=0)에서 필수. 개발에서는 비워 두면 임시 키를 쓴다.
# DJANGO_SECRET_KEY=
# 쉼표로 구분. 기본: localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cloudflare Tunnel 등 https 프록시 뒤에서 쓸 때 쉼표로 구분 (예: https://example.trycloudflare.com)
# DJANGO_CSRF_TRUSTED_ORIGINS=

# ===== LLM: 요약 · 결정 사항 추출 · 챗봇 =====
# 하나만 설정해도 LLM이 켜진다. 순서는 Gemini → (실패 시) Groq → (실패 시) Ollama.
# Gemini: 키와 모델 ID가 둘 다 있어야 한다. https://aistudio.google.com 에서 무료 발급
# GEMINI_API_KEY=
# 쉼표로 여러 모델을 적으면 앞에서부터 시도한다(무료 한도는 모델마다 따로). 예: gemini-3.8-flash,gemini-3.5-flash
# GEMINI_MODEL=
# 응답 대기 초. 기본 60 (응답이 없으면 다음 Gemini 모델로, 모두 안 되면 Groq → Ollama로 넘어간다)
# GEMINI_TIMEOUT=60
# 긴 프롬프트(1~2시간 회의의 결정 추출)는 1만 자마다 이만큼 더 기다리고, 아무리 길어도 상한을 넘기지 않는다
# GEMINI_TIMEOUT_PER_10K=30
# GEMINI_MAX_TIMEOUT=300
# 실패한 Gemini 모델을 건너뛰는 시간(초). 기본 600, 0이면 매번 모든 모델을 시도
# GEMINI_COOLDOWN=600

# Groq: 키와 모델 ID가 둘 다 있어야 한다. STT에 쓰는 GROQ_API_KEY와 같은 키를 쓰면 된다
# (https://console.groq.com 에서 무료 발급). 모델 ID는 콘솔의 현재 무료 모델 목록에서 확인한다.
# GROQ_LLM_MODEL=

# Ollama(로컬): 모델 이름을 적으면 켜진다. 먼저 `ollama pull <모델>` 필요
# OLLAMA_MODEL=qwen2.5:7b
# 기본: http://127.0.0.1:11434/api/generate
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# 컨텍스트 길이. 기본 16384 (긴 회의면 늘리고, 메모리가 부족하면 줄인다)
# OLLAMA_NUM_CTX=16384
# 응답 대기 초. 기본 300
# OLLAMA_TIMEOUT=300

# ===== STT(전사): CLOVA → Groq → 로컬 Whisper 순서로 시도, 앞 단계가 없거나 실패하면 다음으로 =====
# CLOVA Speech: URL과 키가 둘 다 있어야 켜진다 (네이버 클라우드 콘솔 > 빌더 > 설정 > 연동 정보)
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET_KEY=
# 월 무료 사용량(분). 기본 20
# CLOVA_SPEECH_FREE_MINUTES=20
# 1이면 화자 분리 사용
# CLOVA_SPEECH_DIARIZATION=0

# Groq Whisper API: https://console.groq.com 에서 무료 발급
# GROQ_API_KEY=
# 기본: whisper-large-v3-turbo
# GROQ_MODEL=whisper-large-v3-turbo
# 이보다 큰 녹음(1~2시간 회의)은 16kHz 모노 WAV 조각으로 잘라 차례로 보낸다(MB, 기본 24 — Groq 한도 25MB)
# GROQ_MAX_UPLOAD_MB=24
# 조각 길이(초). 기본 600(10분, 약 19MB). 업로드 한도를 넘지 않게 자동으로 줄여 쓴다
# GROQ_CHUNK_SECONDS=600

# 로컬 Whisper: 로컬 전사를 CLOVA보다 우선시키려면 CLOVA·Groq 항목을 주석 처리한다.
# Windows·Linux 등 모든 OS: faster-whisper (pip install faster-whisper 필요)
# FASTER_WHISPER_MODEL=large-v3-turbo
# GPU가 없거나 CUDA 설정이 안 되면 cpu / int8 로 지정
# FASTER_WHISPER_DEVICE=auto
# FASTER_WHISPER_COMPUTE_TYPE=default
# Apple Silicon Mac 전용: mlx-whisper. 둘 다 있으면 MLX가 우선
# MLX_WHISPER_MODEL=

# 로컬 화자 분리: Groq·로컬 Whisper 전사 결과를 "화자 A: ..." 줄로 나눈다 (pip install sherpa-onnx 필요, CPU 동작)
# LOCAL_DIARIZATION=1
# 참석 인원을 알면 지정. 비우면 자동 판단
# DIARIZATION_NUM_SPEAKERS=
# 자동 판단 기준. 기본 0.8 (화자가 너무 많이 나뉘면 올리고, 다른 사람이 합쳐지면 내린다)
# DIARIZATION_THRESHOLD=0.8

# ===== 실시간 회의 세션 =====
# 녹음은 말이 잠깐(약 0.7초) 끊기는 지점에서 잘라 바로 전사한다(Groq → 로컬 Whisper, 화자 분리 없이). 쉬지 않고 말해도
# 이 길이(초)가 되면 자른다
# LIVE_CHUNK_SECONDS=15
# AI가 지금까지의 녹취 전체를 보고 애매한 점을 찾는 간격(초)의 기본값. 진행자가 실시간 화면의 '판단 딜레이 시간'
# 슬라이더(5~60초)로 세션마다 바꿀 수 있다. 일시정지할 때도 바로 한 번 본다
# LIVE_ANALYZE_INTERVAL_SECONDS=15
# 가장 최근 말 몇 개는 바로 뒤에 답이 이어질 수 있어 판단을 미룬다(참고로만 보여 준다). 들어온 지 이 시간(초)이 지난 말은 판단한다
# LIVE_HOLDBACK_LINES=2
# LIVE_HOLDBACK_SECONDS=20
# 실시간 분석은 회의 중 빠른 일차 판단이고, 놓친 것은 회의 뒤 결정 확인이 큰 모델로 다시 본다. 그래서 가벼운 모델을 쓴다.
# 비우면 GEMINI_MODEL 가운데 이름에 lite가 든 모델만 쓰고(큰 모델의 한도는 결정 추출 몫), 그런 모델이 없으면 GEMINI_MODEL을 쓴다
# LIVE_GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini가 안 될 때 실시간 분석이 쓸 Groq 모델. 비우면 GROQ_LLM_MODEL
# LIVE_GROQ_LLM_MODEL=
# 실시간 분석 한 번의 응답 대기(초). 넘으면 다시 보내지 않고 다음 모델(없으면 Groq)로 넘어가거나 이번 분석을 건너뛴다
# LIVE_LLM_TIMEOUT=25
# 실시간 분석에서 실패한 모델을 건너뛰는 시간(초). 결정 추출 등 다른 호출에는 영향 없음
# LIVE_LLM_COOLDOWN=300
# 가벼운 Gemini → Groq가 모두 실패하면 마지막으로 로컬 Ollama(OLLAMA_MODEL)로 본다. 응답 대기(초)는 따로 둔다
# LIVE_OLLAMA_TIMEOUT=120
# 분석할 때 보내는 녹취 길이 상한(자). 넘으면 앞부분부터 덜어 낸다(기본 100000, 2시간 회의가 약 9만 자)
# LIVE_MAX_CONTEXT_CHARS=100000
